# Copier en .env (jamais commité). Valeurs de DEV uniquement.

# PostgreSQL
POSTGRES_USER=stockpredict
POSTGRES_PASSWORD=stockpredict
POSTGRES_DB=stockpredict
# Port exposé sur la machine hôte (changer si un Postgres local occupe déjà 5432)
DB_PORT=5432

# API sources simulées (sources-mock) : clé partagée avec les connecteurs du backend
SOURCES_API_KEY=dev-mock-key
# Pannes permanentes simulées, ex. purchase-orders=timeout ou sales=500 (vide = aucune)
MOCK_PANNES=
# Figer la date « aujourd'hui » du monde simulé (AAAA-MM-JJ, vide = date du jour)
MOCK_DATE_REFERENCE=

# Session (D-12) : secret de signature des jetons. Générer : openssl rand -hex 32
JWT_SECRET=
# Cookie « Secure » : true dès que l'app est servie en HTTPS hors localhost (D-24)
COOKIE_SECURE=false
# Mot de passe des comptes de démonstration créés par `npm run seed` (DEV UNIQUEMENT) :
#   paul.bernard@globalretail.example    RESPONSABLE
#   sarah.lefevre@globalretail.example   ANALYSTE
#   steven.laurent@globalretail.example  ADMIN
DEMO_MOT_DE_PASSE=Demo-StockPredict-2026
